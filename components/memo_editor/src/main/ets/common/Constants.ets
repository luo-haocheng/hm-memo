// 圆环
export const RING_UTF8 = '\u25EF';

// 勾号
export const CHECK_MARK_UTF8 = '\u2713';

// 默认字体大小
export const DEFAULT_FONT_SIZE = 14;

/**
 * 手写画布自带工具栏的高度（vp）。
 *
 * Penkit 的 `HandwriteComponent` **自带画布和一条手写工具栏**，而隐藏它要靠
 * `hiddenTools`（HiddenConfig），那个参数起始版本是 26.0.0 —— 本工程 targetSdk
 * 是 6.1.1(24)，**藏不掉**。所以「切回键盘」按钮得抬到它上方，否则两排工具叠在一起。
 *
 * 它同时决定两件事，改它要一起动：
 *   ① 键盘模式下画布的**裁剪基准**（实际裁剪线还要再往上让出 HANDWRITE_CLIP_MARGIN）
 *   ② 手写模式下「切回键盘」按钮的**避让高度**
 *
 * 【实测值 ≈126】截图量出来的：工具栏面板顶边在画布坐标 596.75vp 处，
 * 组件高 722.67vp → 126vp。**注意工具栏是浮在画布上的覆盖层**，
 * 它并不把画布挤到上方；用户能画到的最深处就是它的顶边。
 */
export const HANDWRITE_TOOLBAR_HEIGHT = 126;

/**
 * 工具栏**投影**向上溢出到画布区的高度（vp）。
 * 键盘模式裁剪时，要在工具栏高度之外**再往上让出这么多**，否则投影的上半截会留在画布区里。
 *
 * 【实测依据】只裁到「工具栏顶边」时，裁剪线上方会留下一条**通栏的灰色渐变带**。
 * 截图逐行取中位色量出来的：中位色从纯白 (255,255,255) 平滑降到 (229,229,229) 才被裁断；
 * 横向取样整行均匀 (235,235,235) —— 没有内容、没有按钮，就是一条渐变。
 * 来源是**工具栏自己的投影**：投影画在工具栏顶边**之上**，只裁到顶边就留下它的上半截。
 *
 * ⚠️ 实测约 21vp，取 22 留一点余量。换设备（DIP/字号不同）可能要微调。
 *
 * ⚠️ **副作用（已知、接受）**：裁剪线因此比工具栏顶边高 22vp，于是手写模式下能画、
 *    键盘模式下看不见的那一条有 22vp 宽。曾用"遮挡条"盖住它，但遮挡条会连编辑层正文
 *    一起盖住（层级对不上），已删除 —— 理由写在 MemoEditorArea 里那段注释。
 */
export const HANDWRITE_CLIP_MARGIN = 22;

